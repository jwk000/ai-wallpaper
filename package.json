{
  "name": "lumen-wallpaper",
  "productName": "Lumen Wallpaper",
  "version": "1.0.0",
  "description": "流光壁纸 · 一个跨平台的单文件 HTML 动态壁纸引擎",
  "main": "src/main/index.js",
  "author": "Lumen",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwk000/ai-wallpaper.git"
  },
  "homepage": "https://github.com/jwk000/ai-wallpaper#readme",
  "bugs": {
    "url": "https://github.com/jwk000/ai-wallpaper/issues"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js --dev",
    "setup:electron": "node scripts/ensure-electron.js --install",
    "postinstall": "node scripts/ensure-electron.js",
    "build:site": "node scripts/build-site.js",
    "sync:site": "node scripts/sync-site-catalog.cjs",
    "verify:site": "node scripts/verify-site.cjs",
    "build:dream-atlas": "node scripts/dream-atlas/build.cjs",
    "verify:dream-atlas": "node scripts/verify-dream-atlas.cjs",
    "preview:site": "node scripts/build-site.js --serve",
    "build:host": "powershell -NoProfile -ExecutionPolicy Bypass -File native/build-windows-host.ps1",
    "release:notes": "node scripts/release-notes.js --out release-notes.md",
    "prebuild:win": "npm run release:notes",
    "build:win": "electron-builder --win",
    "release:win": "npm run build:win -- --publish always",
    "build:mac": "electron-builder --mac",
    "saver": "node screensaver/build.js",
    "saver:install": "node screensaver/build.js --install",
    "saver:test": "node screensaver/build.js --test"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.lumen.wallpaper",
    "productName": "Lumen Wallpaper",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "wallpapers",
        "to": "bundled-wallpapers"
      },
      {
        "from": "native/bin",
        "to": "native/bin"
      }
    ],
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jwk000",
        "repo": "ai-wallpaper",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "流光壁纸"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment",
      "icon": "assets/icon.png",
      "extraResources": [
        {
          "from": "wallpapers",
          "to": "bundled-wallpapers"
        }
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
